{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "baseUrl": ".",
"paths": {
  "@pages/*": ["src/pages/*"],
  "@components/*": ["src/components/*"],
  "@api/*": ["src/api/*"],
  "@fixtures/*": ["src/fixtures/*"],
  "@data/*": ["src/data/*"],
  "@utils/*": ["src/utils/*"]
},
  "include": ["tests", "src", "playwright.config.ts"]
}